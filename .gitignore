# ========================
# Python bytecode / cache
# ========================
__pycache__/
*.pyc
*.pyo
*.pyd

# ========================
# Virtual environments
# ========================
venv/
.env/
.env.*

# ========================
# OS / Editor files
# ========================
.DS_Store
Thumbs.db
.vscode/
.idea/

# ========================
# Logs
# ========================
*.log

# ========================
# Databases (runtime only)
# ========================
*.db
*.sqlite3

# ========================
# Reports & exports (runtime)
# ========================
reports/
*.pdf
*.xlsx
*.csv

# ========================
# Generated charts (runtime)
# ========================
static/charts/
static/*.png

# ========================
# ML training artifacts (DO NOT COMMIT)
# ========================
artifacts/X_train.pkl
artifacts/X_test.pkl
artifacts/y_co2_train.pkl
artifacts/y_co2_test.pkl
artifacts/y_cost_train.pkl
artifacts/y_cost_test.pkl
artifacts/df.pkl

# ========================
# Raw / intermediate datasets
# ========================
data/raw/
data/*_cleaned.csv
data/*_scaled.csv
data/*_features.csv

# ========================
# Model training scripts outputs
# ========================
*.joblib
*.pkl~

# ========================
# Temporary / backup files
# ========================
*~
*.bak
*.tmp

# ========================
# Jupyter
# ========================
.ipynb_checkpoints/

# ========================
# System
# ========================
*.swp
